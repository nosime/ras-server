# ===== GROK2API CONFIGURATION =====
# Port exposed to host
GROK2API_PORT=8000

# Internal server settings
GROK2API_SERVER_HOST=0.0.0.0
GROK2API_SERVER_PORT=8000
GROK2API_SERVER_WORKERS=1

# Logging
GROK2API_LOG_LEVEL=INFO

# Account storage backend: local | redis | mysql | postgresql
GROK2API_ACCOUNT_STORAGE=local
GROK2API_ACCOUNT_LOCAL_PATH=data/accounts.db

# Optional: use Redis for account storage
# GROK2API_ACCOUNT_REDIS_URL=redis://redis:6379/0

# Optional: use MySQL for account storage
# GROK2API_ACCOUNT_MYSQL_URL=mysql://user:password@mysql:3306/grok2api

# Optional: use PostgreSQL for account storage
# GROK2API_ACCOUNT_POSTGRESQL_URL=postgresql://user:password@postgres:5432/grok2api

# Optional: FlareSolverr for CF bypass
# FLARESOLVERR_URL=http://flaresolverr:8191
# CF_REFRESH_INTERVAL=600
# CF_TIMEOUT=60
