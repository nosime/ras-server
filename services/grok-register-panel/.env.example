# ===== GROK REGISTER PANEL CONFIGURATION =====

# Access token - REQUIRED, at least 32 random characters
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MONITOR_TOKEN=your_strong_random_token_here_min_32_chars

# Panel binding host (use 0.0.0.0 for container, specific IP for LAN/Tailscale)
MONITOR_HOST=0.0.0.0
MONITOR_PORT=8787

# Disable raw log tail in production (security best practice)
PANEL_INCLUDE_TAIL=0

# Auth directory paths (inside container)
CPA_AUTH_DIR=/app/cpa_auth
GROK2API_AUTH_DIR=/app/grok2api_auth

# Optional: Proxy pool settings
# PROXY_POOL_STATE_FILE=/app/log/proxy_pool.json
# PROXY_NETWORK_COOLDOWN_SECONDS=90
# PROXY_RISK_COOLDOWN_SECONDS=1800

# Optional: Email domain pool settings
# EMAIL_DOMAIN_POOL_STATE_FILE=/app/log/email_domain_pool.json

# Optional: Xvfb mode (auto | 1 | 0)
# GROK_USE_XVFB=auto

# Optional: Override Camoufox headless mode
# GROK_HEADLESS=1
