# ===== PROJECT CONFIGURATION =====
TZ=Asia/Ho_Chi_Minh
COMPOSE_PROJECT_NAME=ras-server

# ===== CLOUDFLARE TUNNEL =====
CLOUDFLARE_TOKEN=your_cloudflare_tunnel_token_here

# ===== GROK2API =====
# Không public port ra host - cloudflared truy cập qua internal network
# Cloudflare Tunnel route: http://grok2api:8000
GROK2API_SERVER_PORT=8000
GROK2API_LOG_LEVEL=INFO
GROK2API_SERVER_WORKERS=1
GROK2API_ACCOUNT_STORAGE=local
# Optional: redis / mysql / postgresql
# GROK2API_ACCOUNT_REDIS_URL=
# GROK2API_ACCOUNT_MYSQL_URL=
# GROK2API_ACCOUNT_POSTGRESQL_URL=

# ===== GROK REGISTER PANEL =====
# Không public port ra host - cloudflared truy cập qua internal network
# Cloudflare Tunnel route: http://grok-register-panel:8787
# Generate token: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MONITOR_TOKEN=your_strong_random_token_here_min_32_chars
MONITOR_PORT=8787
PANEL_INCLUDE_TAIL=0
# CPA auth directory (inside container)
CPA_AUTH_DIR=/app/cpa_auth
GROK2API_AUTH_DIR=/app/grok2api_auth
